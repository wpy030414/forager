# ===== 服务 =====
PORT=11408
TZ=Asia/Shanghai

# NAS 上的运行身份（容器内以 root 启动后降权到此 uid/gid）
PUID=1000
PGID=1000
# 数据目录（含 forager.db、media/）；Docker 部署时映射到 /data
FORAGER_DATA=./data

# ===== 安全 =====
# 凭据加密密钥（Fernet，urlsafe base64）。不填会自动生成到 data/.secret_key；
# 迁移数据目录时请显式指定，否则旧凭据解不开。生成：
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FORAGER_SECRET_KEY=

# ===== 出口代理（mihomo / Clash Meta）=====
# 订阅地址：clash YAML、ss:// vmess:// trojan:// 链接列表或其 base64 均可。
# 留空 = mihomo 以全部直连运行（forager 照常经它出网，只是不走节点）
CLASH_SUBSCRIBE_URL=
# 固定 mihomo 镜像：tag 钉在发布版本；国内拉不到 Docker Hub 时把镜像名换成加速地址
MIHOMO_IMAGE=metacubex/mihomo
MIHOMO_TAG=v1.19.34
# 应用内全部上游流量的出口（各源的单独设置优先于它）
FORAGER_PROXY=http://mihomo:7890

# ===== 采集策略 =====
# 下载并发（NAS 上建议 1-2）
FORAGER_DOWNLOAD_CONCURRENCY=1
# 采集器巡检间隔（秒）：到点的采集器在这一拍被捡起来跑
FORAGER_SUB_TICK=30
# 同一上游两次请求的最小间隔（毫秒）
FORAGER_MIN_INTERVAL_MS=400

# ===== 源站上游（hanime1）=====
# 匿名即可浏览与下载；下面这些都是可选的覆盖项，留空 = 跟随全局出口
# 可选：单独给 hanime1 指定上游代理
# HANIME1_PROXY=http://127.0.0.1:7897
# 可选：仅 DoH 解析走的代理（未设代理时生效；本地 DNS 被污染时用）
# HANIME1_DNS_PROXY=http://127.0.0.1:7897
# 可选：钉死上游 IPv4，跳过 DoH（CDN 漂移时手动指定）
# HANIME1_RESOLVE=104.26.8.104
# 可选：Cloudflare clearance Cookie（浏览器通过人机验证后从 DevTools 复制）
# 注意：cf_clearance 绑定出口 IP 与浏览器指纹，过期后需重新获取
# HANIME1_COOKIE=cf_clearance=xxxx
# 可选：镜像/换域名时覆盖基址（默认 https://hanime1.me）
# HANIME1_BASE_URL=https://hanime1.me

# ===== 源站上游（Pixiv）=====
# 可选：单独给 Pixiv 指定上游代理（留空 = 走全局出口）
# PIXIV_PROXY=http://127.0.0.1:7897
# 可选：浏览器登录 pixiv 后复制的整串 Cookie（读关注 / 收藏夹类线索需要）
# 至少要含 PHPSESSID 与 pixiv_uid
# PIXIV_COOKIE=PHPSESSID=xxxx; pixiv_uid=12345678
