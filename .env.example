# ===== 服务 =====
PORT=11408
TZ=Asia/Shanghai

# NAS 上的运行身份（容器内以 root 启动后降权到此 uid/gid）
PUID=1000
PGID=1000
# 数据目录（含 forager.db、media/）；Docker 部署时映射到 /data
FORAGER_DATA=./data

# ===== 采集策略 =====
# 下载并发（NAS 上建议 1-2）
FORAGER_DOWNLOAD_CONCURRENCY=1
# 订阅首次运行最多补抓多少条（避免订阅一个分区就拉全站）
FORAGER_SUB_INITIAL=3
# 订阅巡检间隔（秒）
FORAGER_SUB_TICK=30
# 同一上游两次请求的最小间隔（毫秒）
FORAGER_MIN_INTERVAL_MS=400

# ===== 源站上游（hanime1）=====
# 可选：上游请求代理（大陆网络直连被 Cloudflare 拦截时填本机代理）
# HANIME1_PROXY=http://127.0.0.1:7897
# 可选：仅 DoH 解析走的代理（本地 DNS 被污染时用；站点访问仍直连）
# HANIME1_DNS_PROXY=http://127.0.0.1:7897
# 可选：钉死上游 IPv4，跳过 DoH（CDN 漂移时手动指定）
# HANIME1_RESOLVE=104.26.8.104
# 可选：Cloudflare clearance Cookie（浏览器通过人机验证后从 DevTools 复制）
# 注意：cf_clearance 绑定出口 IP 与浏览器指纹，过期后需重新获取
# HANIME1_COOKIE=cf_clearance=xxxx
# 可选：镜像/换域名时覆盖基址（默认 https://hanime1.me）
# HANIME1_BASE_URL=https://hanime1.me

# ===== 源站上游（Bilibili）=====
# 可选：含 SESSDATA 的 Cookie（决定能取到多高的清晰度；匿名只有 360P/480P）
# 从浏览器登录后复制整串 Cookie 即可，buvid3 会由程序自动补齐
# BILIBILI_COOKIE=SESSDATA=xxxx; bilibili_jct=xxxx
# 可选：B 站上游代理（海外访问通常需要 CN 出口）
# BILIBILI_PROXY=http://127.0.0.1:7897
# 可选：请求间隔（毫秒），放太快会吃 -352 风控
# BILIBILI_MIN_INTERVAL_MS=1200
