{
  "name": "forager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @libre-tv/web --filter @libre-tv/server run dev",
    "dev:web": "pnpm --filter @libre-tv/web dev",
    "dev:server": "pnpm --filter @libre-tv/server dev",
    "build": "pnpm --filter @libre-tv/web build",
    "check": "pnpm --filter @libre-tv/web check",
    "test": "pnpm --filter @libre-tv/server test"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  }
}
